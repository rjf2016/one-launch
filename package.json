{
  "name": "one-launch",
  "version": "1.0.0-beta.3",
  "description": "Launch any game, from any launcher, on any account.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "rjf2016",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:fake": "node scripts/dev-fake.mjs",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build && npm run notices && electron-builder --win --dir --publish never",
    "build:installer": "npm run typecheck && electron-vite build && npm run notices && electron-builder --win nsis --publish never",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icon": "electron scripts/render-icon.cjs",
    "notices": "node scripts/third-party-notices.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "drive": "node scripts/drive.mjs",
    "release:keygen": "node scripts/release-keygen.mjs",
    "release:sign": "node scripts/release-sign.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "29.1.1",
    "lucide-react": "1.45.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.0",
    "zustand": "5.0.15"
  }
}
