{
  "fake": "all-four",
  "knobs": {
    "knobs": {
      "battlenet": {
        "updatesPending": ["prometheus"]
      },
      "riot": {
        "runningAs": "11111111-1111-4111-8111-111111111111",
        "updatesPending": ["valorant.live"]
      }
    }
  },
  "steps": [
    {
      "op": "invoke",
      "channel": "library:list"
    },
    {
      "op": "invoke",
      "channel": "launch:preflight",
      "req": {
        "accountId": "@acct:battlenet:saved3@example.com",
        "gameId": "@game:battlenet:prometheus"
      }
    },
    {
      "op": "invoke",
      "channel": "launch:start",
      "req": {
        "accountId": "@acct:battlenet:saved3@example.com",
        "gameId": "@game:battlenet:prometheus",
        "confirmClose": false,
        "instant": false
      }
    },
    {
      "op": "awaitJob",
      "job": "@job:1",
      "until": {
        "state": "failed"
      }
    },
    {
      "op": "invoke",
      "channel": "launch:preflight",
      "req": {
        "accountId": "@acct:battlenet:saved3@example.com",
        "gameId": "@game:battlenet:prometheus"
      }
    },
    {
      "op": "invoke",
      "channel": "launch:start",
      "req": {
        "accountId": "@acct:battlenet:saved3@example.com",
        "gameId": "@game:battlenet:prometheus",
        "confirmClose": false,
        "instant": false
      }
    },
    {
      "op": "awaitJob",
      "job": "@job:2",
      "until": {
        "state": "failed"
      }
    },
    {
      "op": "invoke",
      "channel": "launch:preflight",
      "req": {
        "accountId": "@acct:riot:riot_alt",
        "gameId": "@game:riot:valorant.live"
      }
    },
    {
      "op": "invoke",
      "channel": "launch:start",
      "req": {
        "accountId": "@acct:riot:riot_alt",
        "gameId": "@game:riot:valorant.live",
        "confirmClose": true,
        "instant": false
      }
    },
    {
      "op": "awaitJob",
      "job": "@job:3",
      "until": {
        "state": "failed"
      }
    },
    {
      "op": "invoke",
      "channel": "launch:recent",
      "req": {
        "limit": 10
      }
    },
    {
      "op": "snapshot"
    }
  ]
}
