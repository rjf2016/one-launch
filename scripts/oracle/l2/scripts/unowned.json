{
  "fake": "unowned",
  "steps": [
    {
      "op": "invoke",
      "channel": "accounts:list"
    },
    {
      "op": "invoke",
      "channel": "launch:preflight",
      "req": {
        "accountId": "@acct:epic:alt@example.com"
      }
    },
    {
      "op": "invoke",
      "channel": "launch:preflight",
      "req": {
        "accountId": "@acct:epic:alt@example.com",
        "gameId": "@game:epic:Sugar"
      }
    },
    {
      "op": "invoke",
      "channel": "launch:start",
      "req": {
        "accountId": "@acct:epic:alt@example.com",
        "gameId": "@game:epic:Sugar",
        "confirmClose": false,
        "instant": false
      }
    },
    {
      "op": "awaitJob",
      "job": "@job:1",
      "until": {
        "state": "done"
      }
    },
    {
      "op": "invoke",
      "channel": "launch:preflight",
      "req": {
        "accountId": "@acct:battlenet:saved3@example.com",
        "gameId": "@game:battlenet:prometheus"
      }
    },
    {
      "op": "invoke",
      "channel": "launch:start",
      "req": {
        "accountId": "@acct:battlenet:saved3@example.com",
        "gameId": "@game:battlenet:prometheus",
        "confirmClose": false,
        "instant": false
      }
    },
    {
      "op": "awaitJob",
      "job": "@job:2",
      "until": {
        "state": "done"
      }
    },
    {
      "op": "invoke",
      "channel": "launch:preflight",
      "req": {
        "accountId": "@acct:riot:riot_alt",
        "gameId": null
      }
    },
    {
      "op": "invoke",
      "channel": "launch:start",
      "req": {
        "accountId": "@acct:riot:riot_alt",
        "gameId": null,
        "confirmClose": false,
        "instant": false
      }
    },
    {
      "op": "awaitJob",
      "job": "@job:3",
      "until": {
        "state": "done"
      }
    },
    {
      "op": "invoke",
      "channel": "backups:list",
      "req": {
        "launcher": "epic"
      }
    },
    {
      "op": "invoke",
      "channel": "backups:list",
      "req": {
        "launcher": "battlenet"
      }
    },
    {
      "op": "invoke",
      "channel": "backups:list",
      "req": {
        "launcher": "riot"
      }
    },
    {
      "op": "restart"
    },
    {
      "op": "invoke",
      "channel": "backups:list",
      "req": {
        "launcher": "epic"
      }
    },
    {
      "op": "invoke",
      "channel": "backups:restore",
      "req": {
        "launcher": "epic",
        "id": "@backup:epic:1"
      }
    },
    {
      "op": "invoke",
      "channel": "backups:list",
      "req": {
        "launcher": "epic"
      }
    },
    {
      "op": "snapshot"
    }
  ]
}
