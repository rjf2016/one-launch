{
  "fake": "all-four",
  "knobs": {
    "knobs": {
      "steam": {
        "expiredSessions": ["user_3"]
      },
      "epic": {
        "expired": ["22222222222222222222222222222222"],
        "signInWhenAskedMs": 3000,
        "signInAs": "22222222222222222222222222222222"
      }
    },
    "timing": {
      "steam": {
        "signInMs": 2000,
        "manualSignInMs": 12000
      },
      "epic": {
        "signInMs": 2000
      }
    }
  },
  "steps": [
    {
      "op": "invoke",
      "channel": "launch:preflight",
      "req": {
        "accountId": "@acct:steam:user_3",
        "gameId": "@game:steam:252950"
      }
    },
    {
      "op": "invoke",
      "channel": "launch:start",
