{
  "fake": "all-four",
  "knobs": {
    "processes": {
      "startFails": ["steam.exe"]
    },
    "timing": {
      "steam": {
        "startupMs": 1500
      }
    }
  },
  "steps": [
    {
      "op": "invoke",
      "channel": "launch:preflight",
      "req": {
        "accountId": "@acct:steam:user_3",
        "gameId": "@game:steam:252950"
      }
    },
    {
      "op": "invoke",
      "channel": "launch:start",
      "req": {
        "accountId": "@acct:steam:user_3",
        "gameId": "@game:steam:252950",
        "confirmClose": false,
        "instant": false
      }
    },
    {
      "op": "awaitJob",
      "job": "@job:1",
      "until": {
        "state": "failed"
      }
    },
    {
      "op": "invoke",
      "channel": "backups:list",
      "req": {
        "launcher": "steam"
      }
    },
    {
      "op": "invoke",
      "channel": "launch:recent",
      "req": {
        "limit": 10
      }
    },
    {
      "op": "snapshot"
    }
  ]
}
